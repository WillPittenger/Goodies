<Window xmlns="https://github.com/avaloniaui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				mc:Ignorable="d"
				x:Class="WillPittenger.Goodies.PowerShell.DocBuilder.MainWnd"
				BorderThickness="3"
				CanResize="True"
				FontFamily="Times New Roman"
				MinHeight="600"
				MinWidth="800"
				Padding="5"
				ShowActivated="true"
				ShowInTaskbar="true"
				SizeToContent="WidthAndHeight"
				Title="PowerShell Doc Builder">
	<Window.Styles>
		<Style Selector="NoCmdLets">
			<Setter Property="Background"
							Value="Red"/>
			<Setter Property="BorderBrush"
							Value="Black"/>
			<Setter Property="BorderThickness"
							Value="3"/>
		</Style>
		<Style Selector="NotCompiled">
			<Setter Property="Background"
							Value="Yellow"/>
			<Setter Property="BorderBrush"
							Value="Black"/>
			<Setter Property="BorderThickness"
							Value="3"/>
		</Style>
		<Style Selector="CompiledButNoHelp">
			<Setter Property="Background"
							Value="Purple"/>
			<Setter Property="BorderBrush"
							Value="Black"/>
			<Setter Property="BorderThickness"
							Value="3"/>
		</Style>
		<Style Selector="HasHelp">
			<Setter Property="Background"
							Value="Green"/>
			<Setter Property="BorderBrush"
							Value="Black"/>
			<Setter Property="BorderThickness"
							Value="3"/>
		</Style>
	</Window.Styles>
	<StackPanel Orientation="Vertical">
		<Grid ColumnDefinitions="Auto,10,20,10,Auto,10,20,10,Auto,10,20,10,Auto,10,20"
					RowDefinitions="Auto,10,*">
			<Label Grid.ColumnSpan="6"
						 Content="Color definitions"/>
			<Label Grid.Row="2"
						 Content="No Cmdlets found:"/>
			<Border Grid.Row="2"
							Grid.Column="2"
							Classes="NoCmdLets"/>
			<Label Grid.Row="2"
						 Grid.Column="4"
						 Content="No Cmdlets found:"/>
			<Border Grid.Row="2"
							Grid.Column="6"
							Classes="NotCompiled"/>
			<Label Grid.Row="2"
						 Grid.Column="8"
						 Content="No Cmdlets found:"/>
			<Border Grid.Row="2"
							Grid.Column="10"
							Classes="CompiledButNoHelp"/>
			<Label Grid.Row="2"
						 Grid.Column="12"
						 Content="Help ready for use:"/>
			<Border Grid.Row="2"
							Grid.Column="14"
							Classes="HasHelp"/>
		</Grid>
	</StackPanel>
</Window>