<UserControl xmlns="https://github.com/avaloniaui"
						xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						xmlns:local="using:WillPittenger.Goodies.PowerShell.DocBuilder"
						mc:Ignorable="d"
						x:Class="WillPittenger.Goodies.PowerShell.DocBuilder.TextEditorWithToolBarCtrl">
	<StackPanel Orientation="Vertical"
							Spacing="4">
		<StackPanel Orientation="Vertical"
								Spacing="4">
			<Button Content="Cut"/>
			<Button Content="Copy"/>
			<Button Content="Paste"/>
		</StackPanel>
		<TextBox x:Name="editCtnts"
						Text="{Binding Val, RelativeSource={RelativeSource AncestorType=local:TextEditorWithToolBarCtrl}}"/>
	</StackPanel>
</UserControl>